{
  "manifest_version": 3,
  "name": "VoiceStudio OBS Connector",
  "version": "0.0.9",
  "description": "Reads chat commands like !voice aloud with a different VoiceStudio voice per command, through an OBS browser source. Free and open source (GPL-3.0).",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.twitch.tv/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://rumble.com/*",
    "https://www.rumble.com/*",
    "https://kick.com/*",
    "https://www.kick.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VoiceStudio OBS Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content/common.js",
        "content/twitch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat?*",
        "https://studio.youtube.com/live_chat?*"
      ],
      "js": [
        "content/common.js",
        "content/youtube.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rumble.com/*",
        "https://www.rumble.com/*"
      ],
      "js": [
        "content/common.js",
        "content/rumble.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "content/common.js",
        "content/kick.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}